{
  "swagger": "2.0",
  "info": {
    "title": "JobApps API",
    "description": "Job Application API with Authentication",
    "version": "1.0.0"
  },
  "host": "jobapp-0udd.onrender.com",
  "basePath": "/",
  "schemes": ["https"],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "JWT Authorization header using the Bearer scheme. Example: 'Bearer {token}'"
    },
    "X-Auth-Token": {
      "type": "apiKey",
      "name": "x-auth-token",
      "in": "header",
      "description": "Alternative JWT header. Just paste the token string."
    }
  },
  "paths": {
    "/": {
      "get": {
        "description": "Welcome endpoint",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "description": "Login user and get token",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "email": { "example": "user@example.com" },
                "password": { "example": "password123" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Login successful, returns JWT token" },
          "400": { "description": "Invalid credentials" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/auth/": {
      "get": {
        "description": "Get currently logged-in user info",
        "security": [{ "Bearer": [] }, { "X-Auth-Token": [] }],
        "responses": {
          "200": { "description": "Returns user info" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Logout user (client should delete token)",
        "security": [{ "Bearer": [] }, { "X-Auth-Token": [] }],
        "responses": {
          "200": { "description": "Logout successful, token is now client-side removed" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/users/": {
      "post": {
        "description": "Register new user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "example": "John Doe" },
                "email": { "example": "john@example.com" },
                "password": { "example": "password123" }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "User created" },
          "400": { "description": "Bad request" },
          "500": { "description": "Server error" }
        }
      },
      "get": {
        "description": "Get all users (Protected)",
        "security": [{ "Bearer": [] }, { "X-Auth-Token": [] }],
        "responses": {
          "200": { "description": "Returns all users" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Server error" }
        }
      },
      "put": {
        "description": "Update currently logged-in user info (Protected)",
        "security": [{ "Bearer": [] }, { "X-Auth-Token": [] }],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "name": { "example": "John Doe" },
                "email": { "example": "john@example.com" },
                "password": { "example": "newpassword123" },
                "date": { "example": "2026-03-26" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "User updated" },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Server error" }
        }
      },
      "delete": {
        "description": "Delete currently logged-in user (Protected)",
        "security": [{ "Bearer": [] }, { "X-Auth-Token": [] }],
        "responses": {
          "200": { "description": "User deleted" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/users/me": {
      "get": {
        "description": "Get current logged-in user info (Protected)",
        "security": [{ "Bearer": [] }, { "X-Auth-Token": [] }],
        "responses": {
          "200": { "description": "Returns current user info" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/jobs/": {
      "get": {
        "description": "Get all jobs (Protected)",
        "security": [{ "Bearer": [] }, { "X-Auth-Token": [] }],
        "responses": {
          "200": { "description": "Returns all jobs" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Server error" }
        }
      },
      "post": {
        "description": "Create a new job (Protected)",
        "security": [{ "Bearer": [] }, { "X-Auth-Token": [] }],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "jobTitle": { "type": "string", "example": "Software Engineer" },
                "company": { "type": "string", "example": "Acme Corp" },
                "jobLink": { "type": "string", "example": "https://acme.jobs/123" },
                "status": { "type": "string", "enum": ["applied","interview","rejected","offer"], "example": "applied" },
                "resume": { "type": "string", "example": "https://mylink.com/resume.pdf" },
                "coverLetter": { "type": "string", "example": "I am excited to apply..." },
                "dateApplied": { "type": "string", "format": "date", "example": "2026-03-26" }
              }
            }
          }
        ],
        "responses": {
          "201": { "description": "Job created" },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "description": "Get job by ID (Protected)",
        "security": [{ "Bearer": [] }, { "X-Auth-Token": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Job found" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not Found" },
          "500": { "description": "Server error" }
        }
      },
      "put": {
        "description": "Update job by ID (Protected)",
        "security": [{ "Bearer": [] }, { "X-Auth-Token": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "jobTitle": { "type": "string" },
                "company": { "type": "string" },
                "jobLink": { "type": "string" },
                "status": { "type": "string", "enum": ["applied","interview","rejected","offer"] },
                "resume": { "type": "string" },
                "coverLetter": { "type": "string" },
                "dateApplied": { "type": "string", "format": "date" }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "Job updated" },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not Found" },
          "500": { "description": "Server error" }
        }
      },
      "delete": {
        "description": "Delete job by ID (Protected)",
        "security": [{ "Bearer": [] }, { "X-Auth-Token": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "Job deleted" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not Found" },
          "500": { "description": "Server error" }
        }
      }
    }
  }
}